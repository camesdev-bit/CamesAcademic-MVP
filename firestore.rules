rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile: only the authenticated owner can read/write their own profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Blanket listing forbidden
      allow create, update: if isOwner(userId)
        && request.resource.data.id == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.xp is number
        && request.resource.data.level is number
        && request.resource.data.streak is number;
      allow delete: if false;
    }

    // Materials: owned by the creating user
    match /materials/{materialId} {
      allow get, delete: if isSignedIn() && isValidId(materialId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(materialId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 180;
      allow update: if isSignedIn()
        && isValidId(materialId)
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    // Summaries
    match /summaries/{summaryId} {
      allow get: if isSignedIn() && isValidId(summaryId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn()
        && isValidId(summaryId)
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(summaryId) && resource.data.userId == request.auth.uid;
    }

    // Flashcards
    match /flashcards/{flashcardId} {
      allow get: if isSignedIn() && isValidId(flashcardId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn()
        && isValidId(flashcardId)
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(flashcardId) && resource.data.userId == request.auth.uid;
    }

    // Quiz Questions
    match /questions/{questionId} {
      allow get: if isSignedIn() && isValidId(questionId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn()
        && isValidId(questionId)
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(questionId) && resource.data.userId == request.auth.uid;
    }

    // Concept Mastery Scores
    match /conceptMastery/{masteryId} {
      allow get: if isSignedIn() && isValidId(masteryId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn()
        && isValidId(masteryId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.score is number;
      allow delete: if isSignedIn() && isValidId(masteryId) && resource.data.userId == request.auth.uid;
    }

    // Answers Log
    match /answers/{answerId} {
      allow get: if isSignedIn() && isValidId(answerId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(answerId)
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Answers are immutable logs
    }

    // AI Tutor Chat History
    match /chats/{chatId} {
      allow get: if isSignedIn() && isValidId(chatId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(chatId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 4000;
      allow update, delete: if isSignedIn() && isValidId(chatId) && resource.data.userId == request.auth.uid;
    }
  }
}
